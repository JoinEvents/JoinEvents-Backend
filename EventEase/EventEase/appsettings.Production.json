{
  "ConnectionStrings": {
    "DefaultConnection": "${EVENT_EASE_DB_CONNECTION}"
  },
  "Redis": {
    "Connection": "${REDIS_CONNECTION}"
  },
  "Jwt": {
    "Issuer": "EventEase",
    "Audience": "EventEaseClients",
    "Key": "${JWT_KEY}",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AzureStorage": {
    "ConnectionString": "${AZURE_STORAGE_CONNECTION}",
    "ContainerName": "eventeaseblobcontainer"
  },
  "Gcp": {
    "ProjectId": "${GCP_PROJECT_ID}",
    "BucketName": "join-events-bucket-prod",
    "CredentialsPath": ""
  }
}